rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function follows(viewerUid, ownerUid) {
      return exists(/databases/$(database)/documents/follows/$(viewerUid + '_' + ownerUid));
    }

    function isCircleMember(circleId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/circles/$(circleId)/members/$(request.auth.uid));
    }

    match /users/{userId} {
      allow read, write: if isSelf(userId);

      match /socialInbox/{itemId} {
        allow read, update, delete: if isSelf(userId);
        allow create: if signedIn() &&
          request.resource.data.ownerUid == userId &&
          request.resource.data.actorUid == request.auth.uid;
      }

      match /{document=**} {
        allow read, write: if isSelf(userId);
      }
    }

    match /profiles/{userId} {
      allow read: if signedIn() && (
        userId == request.auth.uid ||
        resource.data.isPublic != false ||
        follows(request.auth.uid, userId) ||
        follows(userId, request.auth.uid)
      );
      allow write: if isSelf(userId);
    }

    match /follows/{docId} {
      allow read: if signedIn() && (
        resource.data.followerUid == request.auth.uid ||
        resource.data.followedUid == request.auth.uid
      );
      allow create: if signedIn() && request.resource.data.followerUid == request.auth.uid;
      allow delete: if signedIn() && resource.data.followerUid == request.auth.uid;
    }

    match /cheers/{docId} {
      allow read: if signedIn() && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toUid == request.auth.uid ||
        follows(request.auth.uid, resource.data.fromUid) ||
        follows(request.auth.uid, resource.data.toUid)
      );
      allow create: if signedIn() && request.resource.data.fromUid == request.auth.uid;
    }

    match /activityEvents/{eventId} {
      allow read: if signedIn() && request.auth.uid in resource.data.viewerUids;
      allow create, update: if signedIn() &&
        request.resource.data.actorUid == request.auth.uid &&
        request.auth.uid in request.resource.data.viewerUids;
      allow delete: if signedIn() && resource.data.actorUid == request.auth.uid;
    }

    match /nudges/{nudgeId} {
      allow read: if signedIn() && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toUid == request.auth.uid
      );
      allow create: if signedIn() && request.resource.data.fromUid == request.auth.uid;
      allow delete: if signedIn() && resource.data.fromUid == request.auth.uid;
    }

    match /circles/{circleId} {
      allow read: if signedIn() && (
        request.auth.uid in resource.data.memberUids ||
        exists(/databases/$(database)/documents/circleInvites/$(resource.data.inviteCode))
      );
      allow create: if signedIn() &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.auth.uid in request.resource.data.memberUids;
      allow update: if signedIn() && (
        request.auth.uid in resource.data.memberUids ||
        request.auth.uid in request.resource.data.memberUids
      );
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      match /members/{memberUid} {
        allow read: if isCircleMember(circleId);
        allow create, update: if signedIn() && (
          memberUid == request.auth.uid ||
          isCircleMember(circleId)
        );
        allow delete: if signedIn() && memberUid == request.auth.uid;
      }
    }

    match /circleInvites/{code} {
      allow read: if signedIn() && resource.data.active != false;
      allow create, update: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }
  }
}
